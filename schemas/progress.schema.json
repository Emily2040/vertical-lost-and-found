{
  "type": "object",
  "required": [
    "project",
    "revision",
    "owners",
    "milestones",
    "overall_status"
  ],
  "properties": {
    "project": {
      "const": "vertical-lost-and-found"
    },
    "milestones": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "status",
          "evidence"
        ]
      }
    },
    "revision": {
      "type": "string",
      "minLength": 1
    },
    "owners": {
      "type": "object",
      "minProperties": 1
    },
    "overall_status": {
      "type": "string",
      "minLength": 1
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Vertical Lost & Found progress record"
}
